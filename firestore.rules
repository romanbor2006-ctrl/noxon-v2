// ============================================================
// firestore.rules — правила доступу до бази noxon.
//
// ЦЕЙ ФАЙЛ — ДЖЕРЕЛО ПРАВДИ. Публікується командою з кореня
// репозиторію (поруч лежить firebase.json):
//
//   firebase deploy --only firestore:rules
//
// Головний принцип: браузеру не віримо. Усе, що можна підробити
// в коді сайту, перевіряється тут.
//
// Поля старих записів читаємо через get('поле', замінник):
// якщо поля немає, вираз не падає, а помилка в одному правилі
// в Firestore блокує весь запит.
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- хто я -------------------------------------------------
    // Роль беремо з бази, а не з браузера: те, що прийшло від
    // людини, ніколи не є підставою для прав.
    function signedIn()  { return request.auth != null; }
    function meRef()     { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function meDoc()     { return get(meRef()).data; }
    // Власник — головний адмін. Визначається за адресою входу з токена
    // Firebase Auth, а не за полем у базі: підробити чи зіпсувати не можна.
    // Той самий логін стоїть у config.js → ownerLogin.
    function ownerEmail() { return 'roman@noxon.local'; }
    function isOwner()   { return signedIn() && request.auth.token.email == ownerEmail(); }
    function isOwnerDoc(d) { return d.get('login', '') == ownerEmail().split('@')[0]; }

    // Гість заходить анонімно: бачить борг, досьє й відгуки, але не має
    // профілю, тож жодна умова на запис для нього не виконується.
    function isGuest()   { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }

    function active()    { return isOwner() || (signedIn() && !isGuest() && exists(meRef()) && meDoc().get('active', false) == true); }
    function role()      { return isOwner() ? 'admin' : meDoc().get('role', 'member'); }
    function canRead()   { return active() || isGuest(); }
    function isAdmin()   { return active() && role() == 'admin'; }
    function isSubject() { return active() && role() == 'subject'; }
    function myName()    { return meDoc().get('name', ''); }

    // Час запису має бути справжнім: ±5 хвилин від серверного.
    function now() { return request.time.toMillis(); }
    function freshTs(v) { return v is int && v > now() - 300000 && v < now() + 300000; }

    function incoming() { return request.resource.data; }
    function stored()   { return resource.data; }
    function changed()  { return incoming().diff(stored()).affectedKeys(); }

    function validName(v) { return v is string && v.size() > 0 && v.size() <= 40; }

    // --- ЛЮДИ ---------------------------------------------------
    match /users/{uid} {
      // свій профіль видно завжди — щоб сайт зрозумів, що тебе вимкнули
      allow read: if active() || (signedIn() && request.auth.uid == uid);

      // новий профіль — тільки свій і активний; кредитор (власник — одразу адмін)
      allow create: if signedIn() && !isGuest() && request.auth.uid == uid
        && incoming().keys().hasOnly(['login', 'name', 'role', 'active'])
        && incoming().login == request.auth.token.email.split('@')[0]
        && validName(incoming().name)
        && ((isOwner() && incoming().role == 'admin') || (!isOwner() && incoming().role == 'member'))
        && incoming().active == true;

      // Ім'я, роль, доступ — лише адмін. Логін незмінний.
      // 1) Профіль власника: роль і доступ можуть бути лише admin / true —
      //    зняти права з власника не може ніхто, навіть він сам
      //    (а зіпсований профіль будь-який адмін може лише полагодити).
      // 2) Роль адміна видає й знімає тільки власник. Звичайний адмін
      //    не змінює роль і доступ іншим адмінам і самому собі.
      allow update: if isAdmin()
        && changed().hasOnly(['name', 'role', 'active'])
        && validName(incoming().name)
        && incoming().role in ['admin', 'subject', 'member']
        && incoming().active is bool
        && (!isOwnerDoc(stored()) || (incoming().role == 'admin' && incoming().active == true))
        && (!changed().hasAny(['role', 'active']) || isOwner()
            || (stored().get('role', 'member') != 'admin' && incoming().role != 'admin'));

      // видалення профілю = повернення людини як нового кредитора
      // при наступному вході. Вимикаємо галочкою, а не видаляємо.
      allow delete: if false;
    }

    // --- БОРГИ --------------------------------------------------
    function validDebt(d) {
      return d.amount is int && d.amount >= 1 && d.amount <= 100000
        && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 80
        && validName(d.creditor)
        && d.get('creditorUid', '') is string
        && d.due is string && d.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Нова заявка: завжди pending, без платежів і заявок, час — зараз.
    function newDebtShape() {
      return incoming().keys().hasOnly(['amount', 'reason', 'creditor', 'creditorUid', 'author', 'due', 'status', 'payments', 'claim', 'ts'])
        && validDebt(incoming())
        && incoming().creditorUid is string && incoming().creditorUid.size() > 0
        && exists(/databases/$(database)/documents/users/$(incoming().creditorUid))
        && incoming().status == 'pending'
        && incoming().payments == []
        && incoming().claim == null
        && freshTs(incoming().ts);
    }
    // Із сайту: кожен сам за себе — лише собі; герой сайту — ніколи.
    function selfDebt() {
      return active()
        && incoming().creditorUid == request.auth.uid
        && incoming().creditor == myName()
        && incoming().author == myName()
        && role() != 'subject';
    }
    // Із Telegram: пише акаунт бота від імені людини, що прив'язала чат
    // (telegram/<uid>) і досі активна. Далі — звичайна модерація адміном.
    function isBot() { return signedIn() && request.auth.token.email == 'bot@noxon.local'; }
    function botDebt() {
      let u = get(/databases/$(database)/documents/users/$(incoming().creditorUid)).data;
      return isBot() && isAdmin()
        && exists(/databases/$(database)/documents/telegram/$(incoming().creditorUid))
        && u.get('active', false) == true
        && u.get('role', 'member') in ['member', 'admin']
        && incoming().creditor == u.get('name', '')
        && incoming().author == incoming().creditor;
    }

    function oldPayments() { return stored().get('payments', []); }
    function newPayments() { return incoming().get('payments', []); }

    // Адмін модерує: статус, сума, дата, опис, кредитор; notified — позначка
    // бота «про цю заявку вже повідомлено в Telegram».
    // Платежі й заявки НЕ чіпає — інакше закрив би борг сам.
    function adminStep() {
      return isAdmin()
        && changed().hasOnly(['status', 'amount', 'reason', 'due', 'creditor', 'creditorUid', 'notified'])
        && incoming().get('notified', false) is bool
        && incoming().status in ['pending', 'approved', 'rejected']
        && validDebt(incoming());
    }

    // Герой сайту заявляє "віддав" (або скасовує заявку) — міняє ТІЛЬКИ claim
    function claimStep() {
      return isSubject()
        && stored().get('status', '') == 'approved'
        && changed().hasOnly(['claim'])
        && (incoming().claim == null
            || (incoming().claim.keys().hasOnly(['amount', 'ts'])
                && incoming().claim.amount is int
                && incoming().claim.amount >= 1
                && incoming().claim.amount <= stored().amount
                && freshTs(incoming().claim.ts)));
    }

    // Кредитор відповідає на заявку. Або "не отримував" (claim → null,
    // платежі ті самі), або "отримав": у кінець списку дописується рівно
    // один платіж на суму із заявки, старі платежі не змінюються.
    // Новий платіж — той, що став у кінець списку
    function newPayment() { return newPayments()[oldPayments().size()]; }

    function confirmStep() {
      return active()
        && stored().get('creditorUid', '') == request.auth.uid
        && stored().get('status', '') == 'approved'
        && stored().get('claim', null) != null
        && changed().hasOnly(['claim', 'payments'])
        && incoming().get('claim', null) == null
        && (!changed().hasAny(['payments'])
            || (newPayments().size() == oldPayments().size() + 1
                && newPayments().hasAll(oldPayments())
                && newPayment().keys().hasOnly(['amount', 'ts'])
                && newPayment().amount == stored().claim.amount
                && freshTs(newPayment().ts)));
    }

    match /debts/{id} {
      allow read: if canRead();

      // Кожен сам за себе: борг вносить тільки той, кому винні, і тільки собі.
      // Навіть адмін не записує боргів за інших; герой сайту не вносить їх зовсім.
      // Єдиний виняток — бот: заявка з Telegram від імені прив'язаної людини.
      allow create: if newDebtShape() && (selfDebt() || botDebt());

      allow update: if adminStep() || claimStep() || confirmStep();
      allow delete: if isAdmin();
    }

    // --- ДОСЬЄ --------------------------------------------------
    // Ім'я, дата народження, робота, контакти й фото реальної людини
    // живуть тут, а не в коді сайту: репозиторій публічний, а цей
    // документ читають лише залогінені й активні. Змінює — адмін.
    function shortStr(v, max) { return v is string && v.size() <= max; }
    function validSubject(d) {
      return d.keys().hasOnly(['name', 'tagline', 'birthday', 'city', 'job', 'telegram', 'instagram', 'about', 'traits', 'timeline', 'photo'])
        && shortStr(d.name, 60) && d.name.size() > 0
        && shortStr(d.tagline, 140)
        && (d.birthday == '' || (d.birthday is string && d.birthday.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && shortStr(d.city, 80) && shortStr(d.job, 120)
        && shortStr(d.telegram, 200) && shortStr(d.instagram, 200)
        && d.about is list && d.about.size() <= 10
        && d.traits is list && d.traits.size() <= 12
        && d.timeline is list && d.timeline.size() <= 30
        && shortStr(d.photo, 400000)
        && (d.photo == '' || d.photo.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'));
    }

    match /site/{doc} {
      allow read: if canRead();
      allow create, update: if isAdmin() && doc == 'subject' && validSubject(incoming());
      allow delete: if false;
    }

    // --- ВІДГУКИ (оцінка + текст, як у Google Maps) ----------
    // id документа = uid того, хто пише: одна людина — один відгук,
    // і написати за іншого неможливо. Тому окремий антиспам не потрібен:
    // повторна публікація лише переписує свій же документ.
    match /ratings/{uid} {
      allow read: if canRead();
      // герой сайту сам себе не оцінює — як власник закладу в Google Maps
      allow create, update: if active() && request.auth.uid == uid
        && role() != 'subject'
        && incoming().keys().hasOnly(['value', 'text', 'user', 'ts'])
        && incoming().value is int && incoming().value >= 1 && incoming().value <= 5
        && incoming().get('text', '') is string && incoming().get('text', '').size() <= 500
        && incoming().user == myName()
        && freshTs(incoming().ts);
      // свій відгук видаляє автор, будь-який — адмін
      allow delete: if isAdmin() || (active() && request.auth.uid == uid);
    }

    // --- ВІДПОВІДІ ПІД ВІДГУКАМИ ---------------------------------
    // Антиспам у ключі: uid_хвилина_слот, слоти 0–2 поточної й
    // попередньої хвилини. Зайнятий ключ створити вдруге не можна.
    function rslot(m, s) { return request.auth.uid + '_' + string(m) + '_' + string(s); }
    function replySlotOk(rid) {
      let m = math.floor(now() / 60000);
      return rid in [rslot(m, 0), rslot(m, 1), rslot(m, 2), rslot(m - 1, 0), rslot(m - 1, 1), rslot(m - 1, 2)];
    }

    match /replies/{rid} {
      allow read: if canRead();
      allow create: if active() && replySlotOk(rid)
        && incoming().keys().hasOnly(['reviewId', 'uid', 'user', 'text', 'ts'])
        && incoming().uid == request.auth.uid
        && incoming().user == myName()
        && incoming().reviewId is string && incoming().reviewId.size() > 0
        && exists(/databases/$(database)/documents/ratings/$(incoming().reviewId))
        && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 300
        && freshTs(incoming().ts);
      allow update: if false;
      allow delete: if isAdmin() || (active() && stored().get('uid', '') == request.auth.uid);
    }

    // --- ВЛАСНІ АЧІВКИ Й ПОСЛУГИ ДМИТРА — редагує лише адмін -------
    match /badges/{id} {
      allow read: if canRead();
      allow create, update: if isAdmin()
        && incoming().keys().hasOnly(['title', 'desc', 'icon', 'earned', 'ts'])
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 40
        && incoming().desc is string && incoming().desc.size() <= 120
        && incoming().icon is string && incoming().icon.size() <= 8
        && incoming().earned is bool && incoming().ts is int;
      allow delete: if isAdmin();
    }

    match /services/{id} {
      allow read: if canRead();
      allow create, update: if isAdmin()
        && incoming().keys().hasOnly(['title', 'price', 'desc', 'photo', 'ts'])
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 60
        && incoming().price is int && incoming().price >= 0 && incoming().price <= 100000
        && incoming().desc is string && incoming().desc.size() <= 200
        && (!('photo' in incoming()) || (incoming().photo is string && incoming().photo.size() <= 200000
            && (incoming().photo == '' || incoming().photo.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'))))
        && incoming().ts is int;
      allow delete: if isAdmin();
    }

    // --- TELEGRAM-БОТ ------------------------------------------
    // Прив'язка: сайт кладе одноразовий код зі своїм uid, бот (акаунт
    // з роллю адміна) читає його, записує telegram/<uid> і видаляє код.
    match /tglinks/{code} {
      allow create: if active() && code.matches('^[A-Za-z0-9]{24,48}$')
        && incoming().keys().hasOnly(['uid', 'ts'])
        && incoming().uid == request.auth.uid
        && freshTs(incoming().ts);
      allow read, delete: if isAdmin();
    }

    // Який чат Telegram належить людині. Бачить і відв'язує — сама людина.
    match /telegram/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if isAdmin()
        && incoming().keys().hasOnly(['chatId', 'name', 'ts'])
        && incoming().chatId is string && incoming().chatId.size() > 0 && incoming().chatId.size() <= 20
        && incoming().name is string && incoming().name.size() <= 40
        && incoming().ts is int;
      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    // Позначки «сповіщення вже надіслано» — лише для бота.
    match /tgsent/{id} {
      allow read, write: if isAdmin();
    }

    // Чернетка заявки, яку людина заповнює в боті, — лише для бота.
    match /tgdraft/{uid} {
      allow read, write: if isBot() && isAdmin();
    }

    // Колекцію comments більше не використовуємо: коментарі стали
    // частиною відгуків. Без правила вона закрита для всіх.
  }
}
